[alias]
        lsa = config --get-regex ^alias
        co = checkout
        ci = commit
        unci = reset --soft HEAD^1
        st = status -uno --porcelain
        br = branch
        bu = branch -u
        lb = branch -v -v
        pwd = rev-parse --abbrev-ref HEAD
        po = push origin
        fpo = push --force-with-lease origin
        h = log --pretty=format:\"%h %ad | %s%d [%an]\" --date=short
        h5 = h -n5
        h10 = h -n10
        h20 = h -n10
        h50 = h -n10
        lstag = ls-remote -t origin refs/tags/$1
        unstage = reset HEAD --
        unchange = checkout --
        wipe = clean -d -x -f
[user]
        name = mrbald
        email = mail@bobah.net
[merge]
        conflictstyle = diff3
[push]
        default = simple
[color "branch"]
        upstream = bold blue

